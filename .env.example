# 应用基础信息
# 当前项目会先读取 .env 公共配置，再根据 APP_ENV 自动叠加 .env.development 或 .env.production
# 应用名称，用于文档展示、日志标识等场景
APP_NAME=RAG Service
# 运行环境标识；本地开发建议 development，服务器部署建议 production
APP_ENV=development
# 是否开启调试模式，开启后通常会输出更详细的错误信息
APP_DEBUG=true
# 当前服务版本号
APP_VERSION=0.1.0
# 日志级别，可选如 DEBUG、INFO、WARNING、ERROR
APP_LOG_LEVEL=INFO

# 跨域配置
# 允许跨域访问的前端来源，多个来源使用英文逗号分隔；留空表示不启用后端 CORS
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
# 可选的来源正则表达式；适合需要放行一组动态子域时使用，留空表示不启用
CORS_ALLOW_ORIGIN_REGEX=
# 是否允许浏览器跨域请求携带 Cookie 等凭证；如前后端采用 Cookie 会话可改为 true
CORS_ALLOW_CREDENTIALS=false
# 允许跨域请求使用的 HTTP 方法，多个方法使用英文逗号分隔
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# 允许跨域请求携带的请求头，多个请求头使用英文逗号分隔
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID
# 允许前端读取的响应头，默认暴露请求追踪头
CORS_EXPOSE_HEADERS=X-Request-ID

# 本地文件存储
# 上传文件保存的根目录，支持相对路径和绝对路径
UPLOAD_ROOT_DIR=data/uploads

# Word 切块配置
# 单个文档切块的目标字符长度
DOC_CHUNK_SIZE=800
# 相邻切块之间保留的重叠字符数，用于降低语义断裂
DOC_CHUNK_OVERLAP=150
# 旧版 Word 文档转换时使用的临时目录
DOC_CONVERT_TEMP_DIR=data/tmp/converted
# 旧版 Word 文档转换超时时间，单位为秒
DOC_CONVERT_TIMEOUT_SECONDS=120
# 上传 ingest 版本；调整解析策略后可通过变更该值触发同原文重新处理
UPLOAD_INGEST_VERSION=v1
# 后台上传 worker 并发数
UPLOAD_WORKER_CONCURRENCY=1
# 后台上传 worker 轮询间隔，单位为秒
UPLOAD_WORKER_POLL_INTERVAL_SECONDS=1
# 上传任务租约时长，单位为秒
UPLOAD_TASK_LEASE_SECONDS=180
# 上传任务心跳刷新间隔，单位为秒
UPLOAD_TASK_HEARTBEAT_INTERVAL_SECONDS=30

# 服务端镜像构建源配置
# 腾讯云服务器建议保留默认值；若构建阶段下载缓慢，可临时改为官方源或其他镜像源
APP_BUILD_APT_MIRROR=https://mirrors.cloud.tencent.com
APP_BUILD_PYPI_MIRROR=https://mirrors.cloud.tencent.com/pypi/simple

# 默认领域词典文件路径，按行存储词项；可替换为你自己的行业词典文件
DOMAIN_DICTIONARY_PATH=data/domain_dictionary.txt

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rag
MYSQL_USERNAME=rag
MYSQL_PASSWORD=change-me

# JWT 鉴权配置
# JWT 用于登录态校验，默认有效期 7 天；生产环境务必替换为高强度随机密钥
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7


# 阿里云 OSS 对象存储配置
# 上传后的原始文件会持久化到阿里云 OSS；UPLOAD_ROOT_DIR 仅作为本地临时工作目录
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_PREFIX=knowledge-files

# 注册邮箱验证码配置
# 该密钥用于生成验证码摘要，生产环境请替换为独立的高强度随机密钥
REGISTRATION_CODE_SECRET=replace-with-a-long-random-registration-code-secret
# 验证码位数，当前实现默认使用纯数字验证码
REGISTRATION_CODE_LENGTH=6
# 验证码有效期，单位为分钟
REGISTRATION_CODE_EXPIRE_MINUTES=10
# 同一邮箱两次发码之间的冷却时间，单位为秒
REGISTRATION_CODE_RESEND_INTERVAL_SECONDS=60
# 单个验证码最多允许输错的次数
REGISTRATION_CODE_MAX_ATTEMPTS=5

# SMTP 邮件发送配置
# 注册验证码邮件将使用以下发件邮箱发送
# SMTP 服务地址，例如 QQ 邮箱、企业邮箱、SendGrid、阿里云邮件推送提供的主机名
SMTP_HOST=smtp.example.com
# SMTP 服务端口；常见为 587（STARTTLS）或 465（SMTPS）
SMTP_PORT=587
# SMTP 登录账号；很多服务要求填完整邮箱地址
SMTP_USERNAME=notice@example.com
# SMTP 登录密码；有些邮箱服务这里要填“授权码”而不是邮箱登录密码
SMTP_PASSWORD=replace-with-smtp-password
# 明文 SMTP 通常配合 STARTTLS；若使用 SMTPS，请把 SMTP_USE_SSL 改为 true 并关闭 SMTP_USE_TLS
# 是否在普通 SMTP 连接建立后升级到 TLS 加密；587 端口通常为 true
SMTP_USE_TLS=true
# 是否直接使用 SSL/TLS 建立加密连接；465 端口通常为 true
SMTP_USE_SSL=false
# 收件人看到的实际发件邮箱地址，决定“这封验证码邮件是谁发的”
SMTP_FROM_EMAIL=notice@example.com
# 收件人看到的发件人名称；留空时默认使用 APP_NAME
SMTP_FROM_NAME=
# 连接 SMTP 和发送邮件时的超时时间，单位为秒
SMTP_TIMEOUT_SECONDS=10

# Elasticsearch 检索配置（必选依赖）
# Elasticsearch 服务在当前系统中为必选，默认建议使用仓库内置的 IK 版本 docker compose
# 具体地址可在 .env.development / .env.production 中按环境覆盖
# Elasticsearch 服务地址
ES_URL=http://127.0.0.1:9200
# chunk 文档写入和检索使用的索引名称
ES_INDEX_NAME=document_chunks
# Elasticsearch 用户名；服务端 docker compose 默认启用认证，内置超级用户通常为 elastic
ES_USERNAME=elastic
# Elasticsearch 密码；服务端部署时必填，建议使用高强度随机密码
ES_PASSWORD=replace-with-elasticsearch-password
# Elasticsearch API Key；与用户名密码二选一，未启用时留空
ES_API_KEY=
# 是否校验 Elasticsearch HTTPS 证书；当前 compose 默认仍走 HTTP，因此通常设为 false
ES_VERIFY_CERTS=false
# Elasticsearch 对外发布地址；默认仅绑定服务器本机。若需本地电脑直连服务器调试，可改为 0.0.0.0:9200，并在安全组/防火墙中限制来源 IP
ES_PUBLISH_ADDRESS=127.0.0.1:9200

# Milvus 向量存储配置（上传与语义检索必选）
# 具体地址可在 .env.development / .env.production 中按环境覆盖
# Milvus 服务地址；本机 docker compose 默认使用 19530 端口
MILVUS_URI=http://127.0.0.1:19530
# Milvus 认证令牌；服务端 docker compose 默认启用认证。若使用内置 root 用户，请写成 root:<MILVUS_ROOT_PASSWORD>
MILVUS_TOKEN=root:replace-with-milvus-root-password
# Milvus root 初始密码；仅用于服务端 compose 初始化内置 root 用户，请与 MILVUS_TOKEN 中的密码保持一致
MILVUS_ROOT_PASSWORD=replace-with-milvus-root-password
# Milvus 数据库名称；默认使用 default
MILVUS_DB_NAME=default
# chunk 向量写入的集合名称
MILVUS_COLLECTION_NAME=document_chunk_vectors
# Milvus 对外发布地址；默认仅绑定服务器本机。若需本地电脑直连服务器调试，可改为 0.0.0.0:19530，并在安全组/防火墙中限制来源 IP
MILVUS_PUBLISH_ADDRESS=127.0.0.1:19530

# 大模型服务配置（上传与检索链路必选）
# 平台无关的首选命名；兼容旧变量 DASHSCOPE_API_KEY / BAILIAN_API_KEY
LLM_API_KEY=
# OpenAI 兼容接口地址；默认示例值保持当前接入平台地址，切换平台时按目标平台地址替换
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型调用超时时间（秒）；兼容旧变量 BAILIAN_TIMEOUT_SECONDS
LLM_TIMEOUT_SECONDS=30
# 聊天模型名称；启用 /chat/completions 聊天接口时必填；兼容旧变量 BAILIAN_CHAT_MODEL
LLM_CHAT_MODEL=
# 文档图片识别使用的多模态模型名称；仅在解析到嵌入图片时调用
IMAGE_RECOGNITION_MODEL=
# 通用重排模型名称；可同时用于检索 chunk 与图片候选重排
RERANK_MODEL=
# 聊天接口系统提示词；默认允许无证据时回答通用问题，但高风险问题仍需明确提示证据不足
CHAT_SYSTEM_PROMPT=你是 {app_name} 的知识库问答助手。如果当前轮提供了知识库证据，优先只基于证据回答，并在相关句子后追加 [1][2] 这类证据编号。如果当前轮没有提供知识库证据，必须明确说明“当前没有检索到可支撑结论的知识库材料”，只能提供一般性说明，不要把未验证内容表述为确定事实。如果问题需要具体制度、条款、业务规则或数据支撑，请建议用户补充材料或转人工核实。

# Chunk 向量化配置
# 默认示例值使用当前接入链路的文本向量模型；切换平台时请替换为目标平台模型名
CHUNK_EMBEDDING_MODEL=text-embedding-v4
# 向量化链路可单独覆盖 API Key；例如聊天走火山、向量化走千问时可填写这里；留空则回退到 LLM_API_KEY
CHUNK_EMBEDDING_LLM_API_KEY=
# 向量化链路可单独覆盖 OpenAI 兼容接口地址；例如千问可使用 DashScope 兼容地址；留空则回退到 LLM_BASE_URL
CHUNK_EMBEDDING_LLM_BASE_URL=
# 向量化链路可单独覆盖超时时间；留空则回退到 LLM_TIMEOUT_SECONDS
CHUNK_EMBEDDING_LLM_TIMEOUT_SECONDS=
# 向量维度；建议先从 1024 开始
CHUNK_EMBEDDING_DIMENSIONS=1024
# 单次批量向量化请求的最大文本条数；请按目标平台的批量限制调整
CHUNK_EMBEDDING_BATCH_SIZE=10

# 检索接口默认返回条数
# /search/chunks 等检索接口默认返回的命中数量
SEARCH_DEFAULT_SIZE=10

